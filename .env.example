# Copy to .env and fill in real values. Never commit .env.

# Supabase connection string — use the session-mode pooler.
# Three options in the Supabase dashboard (Connect → Connection string):
#   1. Direct connection (port 5432) — IPv6-only; fails on most home/VPS networks.
#   2. Transaction pooler (port 6543) — breaks psycopg3 prepared statements.
#   3. Session pooler (port typically 5432 on the pooler host) — REQUIRED.
# Confirm the host and port in the dashboard; do not guess from this comment.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# LLM (S2) — ANTHROPIC_API_KEY is required; missing key fails at startup.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=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

# Voice STT/TTS (S5) — OPENAI_API_KEY is optional at startup (quiz does not
# need it) but required before the first voice message. Model names are
# env-driven so they can move without a code change.
STT_PROVIDER=openai
TTS_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
WHISPER_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_FORMAT=opus
VOICE_MAX_SECONDS=120
VOICE_CONTEXT_MINUTES=120
VOICE_MAX_TURNS=10
# Voice diary (S13) — hard ceiling; M3 stays on VOICE_MAX_SECONDS
DIARY_MAX_SECONDS=90

# Optional — defaults shown
DB_POOL_MIN=1
DB_POOL_MAX=5
LOG_LEVEL=INFO

# Hardening (S18) — operator alerts + runtime files outside the repo.
# OPERATOR_TELEGRAM_ID empty: log loudly, never crash.
OPERATOR_TELEGRAM_ID=
RUNTIME_DIR=
# Defaults when RUNTIME_DIR unset: ~/english-bot-runtime/{bot.log,bot.lock,…}
LOG_FILE=
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3
INSTANCE_LOCK_FILE=
HEARTBEAT_FILE=
ALERT_THROTTLE_FILE=

# W1b — the browser origin apps/api trusts, in addition to
# http://localhost:3000 which is always allowed for `pnpm dev`. No wildcard,
# no regex: the session cookie arrives at W2. Scheme included, no trailing
# slash. The domain is not chosen yet, so leave this empty until W2 and the
# API will allow localhost only.
# WEB_ORIGIN=https://app.example.com
WEB_ORIGIN=

# S4c off-site backup — empty = skip copy (INFO log) + no freshness alert.
# Example (cloud-synced folder that already exists; never mkdir).
# Quote paths that contain spaces (e.g. Google Drive "My Drive"):
# BACKUP_OFFSITE_DIR="/Users/you/My Drive/english-bot-backups"
# Unquoted paths with spaces are also accepted by scripts/backup.sh.
BACKUP_OFFSITE_DIR=
BACKUP_OFFSITE_MAX_AGE_HOURS=48
# Shell-only retention for scripts/backup.sh (default 14):
# BACKUP_OFFSITE_KEEP=14

# W1c — Cloudflare R2, the real off-site backup. This is the copy that
# survives losing the server; the local dump in BACKUP_DIR sits on the same
# disk as the database it came from and survives an accidental DROP, nothing
# more (known issue #6).
#
# All five keys or none. Set none and scripts/backup.sh logs one INFO line and
# keeps dumping locally; set some and it dies, because a half-set group is a
# silent skip waiting to happen (known issue #26).
#
# Create an *Account* API token (not a User token — a User token dies with the
# user who made it), Object Read & Write, scoped to this one bucket.
# R2_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com
#
# R2_SECRET_ACCESS_KEY is a credential: .env is mode 600 and the value is
# never logged, printed, or put in an alert body.
R2_ACCOUNT_ID=
R2_BUCKET=english-bot-backups
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Freshness alarm for the R2 copy. 26h = a 24h cycle plus slack for a late
# cron. The alarm also fires when R2 is unconfigured, which is the whole point
# of known issue #31: an unconfigured backup and a healthy one used to look
# identical. A machine that is not meant to hold backups opts out explicitly:
#   BACKUP_R2_REQUIRED=0
# Leave it unset in production. Forgetting it costs one extra alert on a dev
# machine; forgetting the opposite polarity would cost silence in production.
BACKUP_R2_MAX_AGE_HOURS=26
BACKUP_R2_REQUIRED=

# S15a watched folder — empty = silent no-op for poll / /import / Anki outbox.
# Absolute path outside the repo (Drive-synced folder that already exists).
# Layout (auto-created under WATCH_DIR for each registered user):
#   inbox/<telegram_user_id>/{trancy,language_reactor}/
#   outbox/<telegram_user_id>/
#   processed/<telegram_user_id>/
#   failed/<telegram_user_id>/
# WATCH_DIR="/Users/you/My Drive/english-bot-watch"
WATCH_DIR=

# S24 shared books — comma-separated slugs the operator fans out to every
# approved user (matched via normalize_for_match). Empty = nothing shared.
# Example: SHARED_BOOK_SLUGS=murphy,vocabulary_in_use
SHARED_BOOK_SLUGS=

# S8 couple challenge — empty = feature inert (no daily question, no group
# handling). Set after a registered user runs /here in the shared group and
# paste the chat id here, then restart the bot.
# COUPLE_CHAT_ID=-1001234567890
COUPLE_CHAT_ID=
