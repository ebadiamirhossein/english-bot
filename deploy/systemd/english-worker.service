# W20 — INSTALLED AT THE LAUNCH PASS. W1c wrote this unit and kept it off the
# server because apps/worker/jobs.py and apps/bot/scheduler.py registered the
# same four jobs:
#
#     streak_rollover   monthly_freeze_reset   heartbeat   backup_freshness
#
# W20 made the tables disjoint from the worker's side (#69): the worker runs
# ONLY push_poll, and those four stay the bot's until W22.
# tests/test_backup_r2.py::test_bot_and_worker_job_tables_are_disjoint fails
# the moment they overlap again.
#
# Install (root half of the launch-pass deploy block, #422):
#
#   cp /home/bot/english-bot/deploy/systemd/english-worker.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now english-worker
#   journalctl -u english-worker -n 50 --no-pager   # expect "Scheduler built jobs=push_poll"

[Unit]
Description=English Learning scheduler (APScheduler)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/home/bot/english-bot
ExecStart=/home/bot/english-bot/.venv/bin/python -m apps.worker.main
Restart=always
RestartSec=10
# One worker, always. It takes RUNTIME_DIR/worker.lock at boot — its own file,
# not the bot's bot.lock — and a second start exits non-zero. That guard only
# covers two processes on the same machine.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
